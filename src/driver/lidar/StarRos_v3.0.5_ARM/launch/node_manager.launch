<?xml version="1.0"?>
<launch>  
<arg name="read_once" default="true" />
<param name="frame_id" value="rflink" />
<param name="RT" value="0,0,180,0,0,0,1" /><!-- RX,RY,RZ,TX,TY,TZ,transfl  ag-->
<param name="model" value="R-Fans-32" />
<param name="display_mode" value="overlay" /><!--overlay/pipeline/snapshot-->
<node pkg="rfans_driver" exec="driver_node" name="rfans_driver" output="screen">
  <param name="device_ip" value="192.168.5.3" />
  <param name="device_port" value="2014" />
  <param name="heart_port" value="2030" />
  <param name="msg_port" value="2015" />
  <param name="rps" value="10"/>
  <param name="readfile_path"  value=""/><!--指定ISF路径:/home/bkth/Desktop/RFANS16/*.isf-->
  <param name="cfg_path"       value="$(find rfans_driver)/revise/revise.ini"/>
  <param name="filter_path"    value=""/>
  <param name="save_xyz"  value="false"/>
  <param name="OutXYZ_path"  value="/home/bkth/ros/rfans16/ros.xyz"/>
  <param name="save_isf"  value="false"/>
  <param name="OutISF_path"  value="/home/bkth/ros/rfans16"/><!--指定ISF路径-->
  <param name="use_double_echo" value="false"/>
  <param name="use_gps" value="false"/>
  <param name="read_once" value="false" />
  <param name="algorithm_default" value="false" />
</node>
<node pkg="rviz" exec="rviz" name="rviz"
 args=" -d $(find rfans_driver)/single_Rviz_cfg.rviz"  output="screen"/>
</launch>
